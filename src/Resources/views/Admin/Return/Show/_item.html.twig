{% set variant = rma_product_view(item.productSku) %}

<tr>
    <td>
        <div><strong>{{ variant is not null ? variant.product.name : item.productName }}</strong></div>
        <div class="text-muted small" {{ sylius_test_html_attribute('product-variant-code') }}>
            {{ 'sylius.ui.sku'|trans }}: {{ item.productSku }}
        </div>
    </td>
    <td>
        {% if variant is not null and variant.product.hasOptions() %}
            <div class="d-flex flex-wrap gap-3" {{ sylius_test_html_attribute('product-options') }}>
                {% for optionValue in variant.optionValues %}
                    <span {{ sylius_test_html_attribute('option-name', optionValue.name) }}>
                        <strong>{{ optionValue.name }}:</strong> {{ optionValue.value }}
                    </span>
                {% endfor %}
            </div>
        {% endif %}
    </td>
    <td class="text-end">{{ item.returnQty }}</td>
</tr>
