{% import '@SyliusUi/Macro/buttons.html.twig' as buttons %}

<div class="ui stackable two column grid">
    <div class="ten wide column">
        {% include '@MadcodersSyliusRmaPlugin/Admin/Return/Show/_header.html.twig' %}
    </div>
    <div class="six wide right aligned column">

        {% set path = path('madcoders_rma_admin_order_return_index') %}
        {{ buttons.default(path, '', 'back', 'arrow alternate circle left outline') }}

        {% if order_return.orderReturnStatus == 'new' %}
            {% set pathDone = path('madcoders_rma_admin_order_return_show_complete', {'id': order_return.id, '_csrf_token': csrf_token(order_return.id) }) %}
            {{ buttons.default(pathDone, 'sylius.ui.complete'|trans, order_return.id, 'check circle outline', 'complete-button green') }}
        {% endif %}

        {% if order_return.orderReturnStatus == 'cancellation_request' %}
            {% set pathConfirm = path('madcoders_rma_admin_order_return_show_confirm_cancellation', {'id': order_return.id, '_csrf_token': csrf_token(order_return.id) }) %}
            {{ buttons.default(pathConfirm, 'madcoders_rma.ui.withdrawal.confirm_cancellation'|trans, order_return.id, 'check circle outline', 'confirm-cancellation-button green') }}

            {% set pathFallback = path('madcoders_rma_admin_order_return_show_fallback_to_return', {'id': order_return.id, '_csrf_token': csrf_token(order_return.id) }) %}
            {{ buttons.default(pathFallback, 'madcoders_rma.ui.withdrawal.fallback_to_return'|trans, order_return.id, 'exchange', 'fallback-to-return-button blue') }}
        {% endif %}

       {% if order_return.orderReturnStatus not in ['completed', 'canceled', 'cancellation_request', 'withdrawn'] %}
            {% set pathCancel = path('madcoders_rma_admin_order_return_show_cancel', {'id': order_return.id, '_csrf_token': csrf_token(order_return.id) }) %}
            {{ buttons.default(pathCancel, 'sylius.ui.cancel'|trans, order_return.id, 'cancel', 'cancel-button red') }}
        {% endif %}

    </div>
</div>
