<div class="card">
    <div class="card-header"><h3 class="card-title">{{ 'madcoders_rma.ui.add_notes'|trans }}</h3></div>
    <div class="card-body" {{ sylius_test_html_attribute('madcoders-rma-add-note-to-timeline') }}>
        {{ form_start(form, {
            action: path('madcoders_rma_admin_order_return_show', { id: order_return.id }),
            attr: { novalidate: 'novalidate' }
        }) }}
            {{ form_row(form.note) }}
            {{ form_row(form._token) }}
            <button type="submit" class="btn btn-primary mt-2" {{ sylius_test_html_attribute('send-note-button') }}>
                {{ 'sylius.ui.add'|trans }}
            </button>
        {{ form_end(form, { render_rest: false }) }}
    </div>
</div>
