<div class="card">
    <div class="card-header"><h3 class="card-title">{{ 'madcoders_rma.ui.timeline'|trans }}</h3></div>
    <div class="card-body" {{ sylius_test_html_attribute('madcoders-rma-timeline') }}>
        <ul class="list-unstyled mb-0">
            {% for logItem in change_log %}
                <li class="mb-3">
                    <div class="text-muted small">{{ rma_time_ago_view(logItem.createdAt) }}</div>
                    {% include rma_time_line_item_view(logItem) with { logItem: logItem, data: order_return } %}
                </li>
            {% endfor %}
        </ul>
    </div>
</div>
