{% set channel = hookable_metadata.context.channel %}
{% set channel_form = hookable_metadata.context.channel_form %}
{% set address_form = hookable_metadata.context.address_form %}

<div class="row row-cards">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">{{ 'madcoders_rma.admin.configuration.select_channel'|trans }}</h3>
            </div>
            <div class="card-body">
                {{ form_start(channel_form, {
                    action: path('madcoders_rma_admin_order_return_config_change_channel'),
                    attr: { novalidate: 'novalidate' }
                }) }}
                    {{ form_row(channel_form.channelChoice, sylius_test_form_attribute('rma-admin-channel-choice-field')) }}
                    {{ form_row(channel_form._token) }}
                    <button type="submit" class="btn btn-primary mt-2" id="sylius_change_channel_button"
                            {{ sylius_test_html_attribute('rma-admin-config-change-channel-button') }}>
                        {{ 'madcoders_rma.ui.change_channel_button'|trans }}
                    </button>
                {{ form_end(channel_form, { render_rest: false }) }}
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    {{ 'madcoders_rma.admin.configuration.change_return_addresss_to_channel'|trans }}: {{ channel.name }}
                </h3>
            </div>
            <div class="card-body">
                {{ form_start(address_form, {
                    action: path('madcoders_rma_admin_order_return_config_add_address_to_selected_channel', { channelId: channel.id }),
                    attr: { novalidate: 'novalidate' }
                }) }}
                    {{ form_errors(address_form) }}
                    {% include '@MadcodersSyliusRmaPlugin/Admin/Configuration/Show/Form/_address.html.twig' with { form: address_form } %}
                    {{ form_row(address_form._token) }}
                    <button type="submit" id="sylius_save_changes_button" class="btn btn-primary w-100 mt-2"
                            {{ sylius_test_html_attribute('rma-continue-button') }}>
                        {{ 'madcoders_rma.ui.continue_button'|trans }}
                    </button>
                {{ form_end(address_form, { render_rest: false }) }}
            </div>
        </div>
    </div>
</div>
