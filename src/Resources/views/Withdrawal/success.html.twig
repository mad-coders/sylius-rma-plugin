{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'madcoders_rma.ui.withdrawal.title'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
    <div class="container my-auto">
        <div class="row justify-content-center mt-4 mb-5">
            <div class="col-12 col-md-6 text-center">
                <div class="mb-4" id="sylius-thank-you" {{ sylius_test_html_attribute('thank-you') }}>
                    {{ ux_icon('tabler:circle-check', { class: 'text-success mb-2', width: '3rem', height: '3rem' }) }}
                    <h1 class="h2">{{ 'madcoders_rma.ui.success.thank_you'|trans }}</h1>
                    <p class="text-muted mb-0">
                        {{ (withdrawn ? 'madcoders_rma.ui.withdrawal.success_withdrawn' : 'madcoders_rma.ui.withdrawal.success_requested')|trans }}
                    </p>
                </div>
                <div class="card">
                    <div class="card-body">
                        <strong>{{ 'madcoders_rma.ui.return_number'|trans }}: {{ orderReturn.returnNumber }}</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
