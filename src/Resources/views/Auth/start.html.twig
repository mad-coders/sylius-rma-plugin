{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% form_theme form '@SyliusShop/form/theme.html.twig' %}

{% block title %}{{ 'sylius.ui.return'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
    <div class="container my-auto">
        <div class="row justify-content-center mt-4 mb-5">
            <div class="col-12 col-md-6">
                <div class="mb-4 text-center">
                    <h1 class="h2">{{ 'madcoders_rma.ui.headline'|trans }}</h1>
                    <p class="text-muted mb-0">{{ 'sylius.ui.return'|trans }}</p>
                </div>
                <div class="card">
                    <div class="card-body">
                        {{ form_start(form, { action: path('madcoders_rma_start'), attr: { novalidate: 'novalidate' } }) }}
                            {{ form_row(form.orderNumber, sylius_test_form_attribute('rma-order-number-field')) }}
                            {{ form_row(form._token) }}
                            <div class="d-grid mt-3">
                                <button type="submit" class="btn btn-primary" {{ sylius_test_html_attribute('rma-submit-button') }}>{{ 'madcoders_rma.ui.continue_button'|trans }}</button>
                            </div>
                        {{ form_end(form, { render_rest: false }) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
