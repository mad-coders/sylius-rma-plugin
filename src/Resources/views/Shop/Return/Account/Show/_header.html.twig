{% set order_return = hookable_metadata.context.order_return %}

<div class="mb-4">
    <h1 class="h3">{{ 'madcoders_rma.ui.return_number'|trans }} #{{ order_return.returnNumber }}</h1>
    <div class="text-muted d-flex gap-2 align-items-center flex-wrap" {{ sylius_test_html_attribute('return-number') }}>
        <span>{{ order_return.createdAt|format_date }}</span>
        {% include [
            '@MadcodersSyliusRmaPlugin/Shop/Return/Label/State/' ~ order_return.orderReturnStatus ~ '.html.twig',
            '@SyliusUi/label/default.html.twig'
        ] with { value: 'sylius.ui.' ~ order_return.orderReturnStatus } %}
    </div>
</div>
