{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'sylius.ui.return'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
    <div class="container my-auto">
        <div class="row justify-content-center mt-4 mb-5">
            <div class="col-12 col-md-6 text-center">
                <div class="mb-4" id="sylius-thank-you" {{ sylius_test_html_attribute('thank-you') }}>
                    {{ ux_icon('tabler:rocket', { class: 'text-primary mb-2', width: '3rem', height: '3rem' }) }}
                    <h1 class="h2">{{ 'madcoders_rma.ui.success.thank_you'|trans }}</h1>
                    <p class="text-muted mb-0">{{ 'madcoders_rma.ui.success.return_form_created'|trans }}</p>
                </div>
                <div class="card">
                    <div class="card-body">
                        <strong>{{ 'madcoders_rma.ui.return_number'|trans }}: {{ returnNumber }}</strong>
                        {% if madcoders_rma_return_form_pdf_enabled() %}
                            <p class="mt-3">{{ 'madcoders_rma.ui.success.order_return_instruction'|trans }}</p>
                            <a href="{{ path('madcoders_rma_return_form_print', { returnNumber: returnNumber }) }}" class="btn btn-primary">
                                {{ 'madcoders_rma.ui.success.print_order_return_form'|trans }}
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
