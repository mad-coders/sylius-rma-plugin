{% set variant = rma_product_view(item.productSku) %}
<tr>
    <td>
        <div><strong>{{ variant is not null ? variant.product.name : item.productName }}</strong></div>
        <div class="text-muted small">{{ 'sylius.ui.sku'|trans }}: {{ item.productSku }}</div>
    </td>
    <td>
        {% if variant is not null and variant.product.hasOptions() %}
            <div class="d-flex flex-wrap gap-3">
                {% for optionValue in variant.optionValues %}<span><strong>{{ optionValue.name }}:</strong> {{ optionValue.value }}</span>{% endfor %}
            </div>
        {% endif %}
    </td>
    <td class="text-end">{{ item.returnQty }}</td>
</tr>
