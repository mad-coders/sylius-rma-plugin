<div class="row">
    <div class="col-md-6">{{ form_row(form.firstName, sylius_test_form_attribute('first-name')) }}</div>
    <div class="col-md-6">{{ form_row(form.lastName, sylius_test_form_attribute('last-name')) }}</div>
</div>
<div class="row">
    <div class="col-md-6">{{ form_row(form.phoneNumber) }}</div>
    <div class="col-md-6">{{ form_row(form.customerEmail) }}</div>
</div>
{{ form_row(form.company, sylius_test_form_attribute('company')) }}
{{ form_row(form.street, sylius_test_form_attribute('street')) }}
{{ form_row(form.countryCode) }}
{% if form.provinceCode is defined %}
    {{ form_row(form.provinceCode, sylius_test_form_attribute('province-code')) }}
{% elseif form.provinceName is defined %}
    {{ form_row(form.provinceName, sylius_test_form_attribute('province-name')) }}
{% endif %}
<div class="row">
    <div class="col-md-6">{{ form_row(form.city, sylius_test_form_attribute('city')) }}</div>
    <div class="col-md-6">{{ form_row(form.postcode, sylius_test_form_attribute('postcode')) }}</div>
</div>
