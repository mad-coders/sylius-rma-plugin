{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% form_theme form '@SyliusShop/form/theme.html.twig' %}
{% form_theme form.items '@MadcodersSyliusRmaPlugin/Return/Form/_item.html.twig' %}

{% block title %}{{ 'sylius.ui.return'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
    <div class="container my-4">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-9">
                <div class="mb-4 text-center">
                    <h1 class="h2">{{ 'madcoders_rma.ui.headline'|trans }} #{{ orderNumber }}</h1>
                    <p class="text-muted mb-0">{{ 'madcoders_rma.ui.fill_the_form_step.secondary_headline'|trans }}</p>
                </div>
                <div class="card">
                    <div class="card-body">
                        {{ form_start(form, { action: formAction|default(path('madcoders_rma_return_form', { orderNumber: orderNumber })), attr: { novalidate: 'novalidate' } }) }}
                            <h3 class="h4 border-bottom pb-2">{{ 'sylius.ui.items'|trans }}</h3>
                            <p class="text-muted">{{ 'madcoders_rma.ui.fill_the_form_step.selecte_items_to_return_form'|trans }}</p>
                            <div class="table-responsive">
                                <table id="madcoders-rm-return-items" {{ sylius_test_html_attribute('madcoders-rm-return-items') }} class="table table-vcenter">
                                    <thead>
                                        <tr>
                                            <th>{{ 'sylius.ui.item'|trans }}</th>
                                            <th>{{ 'sylius.ui.product_options'|trans }}</th>
                                            <th class="text-end">{{ 'sylius.ui.qty'|trans }}</th>
                                        </tr>
                                    </thead>
                                    <tbody>{{ form_row(form.items) }}</tbody>
                                </table>
                            </div>

                            <h3 class="h4 border-bottom pb-2 mt-4">{{ 'sylius.ui.address'|trans }}</h3>
                            <p class="text-muted">{{ 'madcoders_rma.ui.fill_the_form_step.verify_address'|trans }}</p>
                            {% include '@MadcodersSyliusRmaPlugin/Return/Form/_address.html.twig' with { form: form } %}

                            <h3 class="h4 border-bottom pb-2 mt-4">{{ 'madcoders_rma.ui.fill_the_form_step.return_reason_headline'|trans }}</h3>
                            <p class="text-muted">{{ 'madcoders_rma.ui.fill_the_form_step.return_reason_subheader'|trans }}</p>
                            {{ form_row(form.returnReason, sylius_test_form_attribute('rma-return-returnReason')) }}

                            {% if form.bankAccountNumber is defined %}
                                <h3 class="h4 border-bottom pb-2 mt-4">
                                    {{ (form.accountHolderName is defined ? 'madcoders_rma.ui.fill_the_form_step.additional_information_headline' : 'madcoders_rma.ui.fill_the_form_step.bank_account_number_headline')|trans }}
                                </h3>
                                <p class="text-muted">{{ (form.accountHolderName is defined ? 'madcoders_rma.ui.fill_the_form_step.additional_information_subheader' : 'madcoders_rma.ui.fill_the_form_step.bank_account_number_subheader')|trans }}</p>
                                {{ form_row(form.bankAccountNumber, sylius_test_form_attribute('return-bankAccountNumber')) }}
                                {% if form.accountHolderName is defined %}{{ form_row(form.accountHolderName, sylius_test_form_attribute('return-accountHolderName')) }}{% endif %}
                                {% if form.bankName is defined %}{{ form_row(form.bankName, sylius_test_form_attribute('return-bankName')) }}{% endif %}
                            {% endif %}

                            <h3 class="h4 border-bottom pb-2 mt-4">{{ 'madcoders_rma.ui.fill_the_form_step.comment'|trans }}</h3>
                            <p class="text-muted">{{ 'madcoders_rma.ui.fill_the_form_step.add_your_comments_here'|trans }}</p>
                            {{ form_row(form.customerNote) }}

                            {{ form_row(form._token) }}
                            <div class="d-grid mt-3">
                                <button type="submit" class="btn btn-primary" {{ sylius_test_html_attribute('madcoders-rma-submit-return-form-button') }}>{{ 'madcoders_rma.ui.continue_button'|trans }}</button>
                            </div>
                        {{ form_end(form, { render_rest: false }) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
