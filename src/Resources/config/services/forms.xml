<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autoconfigure="true" autowire="true" public="true" />

        <service id="madcoders.sylius_rma_plugin.form.type.return_consent_form_type" class="Madcoders\SyliusRmaPlugin\Form\Type\ReturnConsentFormType">
            <tag name="form.type"/>
        </service>

        <service id="madcoders.sylius_rma_plugin.form.type.order_return_consent_form_type" class="Madcoders\SyliusRmaPlugin\Form\Type\OrderReturnConsentFormType">
            <argument type="service" id="sylius.translation_locale_provider" />
            <tag name="form.type"/>
        </service>

        <service id="madcoders.sylius_rma_plugin.form.type.return_reason_translation_type" class="Madcoders\SyliusRmaPlugin\Form\Type\ReturnReasonTranslationType">
            <argument type="string">Madcoders\SyliusRmaPlugin\Entity\OrderReturnReasonTranslation</argument>
            <tag name="form.type"/>
        </service>

        <service id="madcoders.sylius_rma_plugin.form.type.order_return_consent_translation_type"
                 class="Madcoders\SyliusRmaPlugin\Form\Type\OrderReturnConsentTranslationType">
            <argument type="string">Madcoders\SyliusRmaPlugin\Entity\OrderReturnConsentTranslation</argument>
            <tag name="form.type"/>
        </service>

        <service id="madcoders.sylius_rma_plugin.services.reason.return_deadline_checker"
                 class="Madcoders\SyliusRmaPlugin\Services\Reason\ElapsedDaysReturnDeadlineChecker" />
        <service id="Madcoders\SyliusRmaPlugin\Services\Reason\ReturnDeadlineCheckerInterface"
                 alias="madcoders.sylius_rma_plugin.services.reason.return_deadline_checker" />

        <service id="madcoders.sylius_rma_plugin.services.reason.return_reason_eligibility_checker"
                 class="Madcoders\SyliusRmaPlugin\Services\Reason\ReturnReasonEligibilityChecker">
            <argument type="service" id="madcoders.sylius_rma_plugin.services.reason.return_deadline_checker" />
        </service>
        <service id="Madcoders\SyliusRmaPlugin\Services\Reason\ReturnReasonEligibilityCheckerInterface"
                 alias="madcoders.sylius_rma_plugin.services.reason.return_reason_eligibility_checker" />

        <service id="madcoders.sylius_rma_plugin.form.choice_provider.reason" class="Madcoders\SyliusRmaPlugin\Services\Reason\ChoiceProvider">
            <argument type="service" id="madcoders_rma.repository.order_return_reason" />
            <argument type="service" id= "sylius.repository.order" />
            <argument type="service" id="madcoders.sylius_rma_plugin.services.reason.return_reason_eligibility_checker" />
            <argument type="service" id="madcoders.sylius_rma_plugin.services.return_eligibility_checker" />
        </service>

        <service id="madcoders.sylius_rma_plugin.form.choice_provider.withdrawal_reason" class="Madcoders\SyliusRmaPlugin\Services\Reason\WithdrawalChoiceProvider">
            <argument type="service" id="madcoders_rma.repository.order_return_reason" />
        </service>

        <service id="madcoders.sylius_rma_plugin.form.type.return_form_type" class="Madcoders\SyliusRmaPlugin\Form\Type\ReturnFormType">
            <argument type="service" id="madcoders.sylius_rma_plugin.form.choice_provider.reason" />
            <tag name="form.type" />
        </service>

        <!--
            Adds the flag-gated "Additional information" section to the standard return form. Defined
            explicitly (autoconfigure off) so the form.type_extension tag is registered exactly once;
            the extended type comes from ReturnFormTypeExtension::getExtendedTypes().
        -->
        <service id="madcoders.sylius_rma_plugin.form.extension.return_form_type_extension"
                 class="Madcoders\SyliusRmaPlugin\Form\Extension\ReturnFormTypeExtension"
                 autoconfigure="false">
            <argument type="service" id="madcoders.sylius_rma_plugin.services.additional_information_checker" />
            <tag name="form.type_extension" />
        </service>

        <service id="madcoders.sylius_rma_plugin.form.type.withdrawal_return_form_type" class="Madcoders\SyliusRmaPlugin\Form\Type\WithdrawalReturnFormType">
            <argument type="service" id="madcoders.sylius_rma_plugin.form.choice_provider.withdrawal_reason" />
            <tag name="form.type" />
        </service>

        <service id="madcoders.sylius_rma_plugin.form.type.config_channel_select_form_type"
                 class="Madcoders\SyliusRmaPlugin\Form\Type\ConfigChannelSelectFormType">
            <argument type="service" id= "sylius.repository.channel" />
            <tag name="form.type" />
        </service>

        <service id="madcoders.sylius_rma_plugin.form.type.config_address_to_channel_form_type"
                 class="Madcoders\SyliusRmaPlugin\Form\Type\ConfigAddressToChannelFormType">
            <tag name="form.type" />
        </service>

        <service id="madcoders.sylius_rma_plugin.form.extension.product_type_extension"
                 class="Madcoders\SyliusRmaPlugin\Form\Extension\ProductTypeExtension">
            <tag name="form.type_extension" extended-type="Sylius\Bundle\ProductBundle\Form\Type\ProductType" />
        </service>

    </services>
</container>
