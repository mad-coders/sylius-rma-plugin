<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <!--
        The Twig extensions below declare their functions with the #[Twig\Attribute\AsTwigFunction]
        PHP attribute (Twig 3.21+) instead of implementing Twig\Extension\ExtensionInterface.

        Each one is wired twice: the class itself is tagged "twig.runtime" so Twig's runtime loader
        resolves it by class name (keeping constructor injection), and a Twig\Extension\AttributeExtension
        wrapper - a real ExtensionInterface implementation that Twig ships, which reads the attributes
        via reflection - is tagged "twig.extension" to expose the functions to Twig.

        Symfony's own "twig.attribute_extension" tag does the same thing in one step, but it only
        exists from symfony/twig-bundle 7.3. Sylius 2.2 still permits Symfony 6.4, where that tag is
        silently ignored and every function below would go unregistered with no error at all. The
        explicit wrapper works on both, so it is what this plugin uses. Keep this identical to the
        1.x branches; it is deliberately the same wiring on every line.
        -->

        <service id="madcoders.sylius_rma_plugin.rma_product_view_extension"
                 class="Madcoders\SyliusRmaPlugin\Twig\RmaProductViewExtension">
            <argument type="service" id="sylius.repository.product_variant" />
            <tag name="twig.runtime"/>
        </service>
        <service id="madcoders.sylius_rma_plugin.rma_product_view_extension.twig_extension" class="Twig\Extension\AttributeExtension">
            <argument>Madcoders\SyliusRmaPlugin\Twig\RmaProductViewExtension</argument>
            <tag name="twig.extension"/>
        </service>

        <service id="madcoders.sylius_rma_plugin.twig.rma_order_view_extension"
                 class="Madcoders\SyliusRmaPlugin\Twig\RmaOrderViewExtension">
            <argument type="service" id="sylius.repository.order" />
            <tag name="twig.runtime"/>
        </service>
        <service id="madcoders.sylius_rma_plugin.twig.rma_order_view_extension.twig_extension" class="Twig\Extension\AttributeExtension">
            <argument>Madcoders\SyliusRmaPlugin\Twig\RmaOrderViewExtension</argument>
            <tag name="twig.extension"/>
        </service>

        <service id="madcoders.sylius_rma_plugin.twig.rma_reason_choice_extension"
                 class="Madcoders\SyliusRmaPlugin\Twig\RmaReasonChoiceExtension">
            <argument type="service" id="madcoders.sylius_rma_plugin.form.choice_provider.reason" />
            <tag name="twig.runtime"/>
        </service>
        <service id="madcoders.sylius_rma_plugin.twig.rma_reason_choice_extension.twig_extension" class="Twig\Extension\AttributeExtension">
            <argument>Madcoders\SyliusRmaPlugin\Twig\RmaReasonChoiceExtension</argument>
            <tag name="twig.extension"/>
        </service>

        <service id="madcoders.sylius_rma_plugin.twig.rma_time_line_extension"
                 class="Madcoders\SyliusRmaPlugin\Twig\RmaTimeLineExtension">
            <tag name="twig.runtime"/>
        </service>
        <service id="madcoders.sylius_rma_plugin.twig.rma_time_line_extension.twig_extension" class="Twig\Extension\AttributeExtension">
            <argument>Madcoders\SyliusRmaPlugin\Twig\RmaTimeLineExtension</argument>
            <tag name="twig.extension"/>
        </service>

        <service id="madcoders.sylius_rma_plugin.twig.rma_time_ago_extension"
                 class="Madcoders\SyliusRmaPlugin\Twig\RmaTimeAgoExtension">
            <tag name="twig.runtime"/>
        </service>
        <service id="madcoders.sylius_rma_plugin.twig.rma_time_ago_extension.twig_extension" class="Twig\Extension\AttributeExtension">
            <argument>Madcoders\SyliusRmaPlugin\Twig\RmaTimeAgoExtension</argument>
            <tag name="twig.extension"/>
        </service>

        <service id="madcoders.sylius_rma_plugin.twig.rma_verification_possibility_of_return_extension"
                 class="Madcoders\SyliusRmaPlugin\Twig\RmaVerificationPossibilityOfReturnExtension">
            <argument type="service" id="madcoders.sylius_rma_plugin.services.rma_verification_possibility_of_return" />
            <argument type="service" id="madcoders.sylius_rma_plugin.services.withdrawal.eligibility_checker" />
            <tag name="twig.runtime"/>
        </service>
        <service id="madcoders.sylius_rma_plugin.twig.rma_verification_possibility_of_return_extension.twig_extension" class="Twig\Extension\AttributeExtension">
            <argument>Madcoders\SyliusRmaPlugin\Twig\RmaVerificationPossibilityOfReturnExtension</argument>
            <tag name="twig.extension"/>
        </service>

        <service id="madcoders.sylius_rma_plugin.twig.rma_config_extension"
                 class="Madcoders\SyliusRmaPlugin\Twig\RmaConfigExtension">
            <argument>%madcoders_rma.return_form_pdf_enabled%</argument>
            <argument>%madcoders_rma.allow_unpaid_withdrawal%</argument>
            <argument type="service" id="madcoders.sylius_rma_plugin.services.additional_information_checker" />
            <tag name="twig.runtime"/>
        </service>
        <service id="madcoders.sylius_rma_plugin.twig.rma_config_extension.twig_extension" class="Twig\Extension\AttributeExtension">
            <argument>Madcoders\SyliusRmaPlugin\Twig\RmaConfigExtension</argument>
            <tag name="twig.extension"/>
        </service>

    </services>

</container>
