<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autoconfigure="true" autowire="true" public="true" />

        <service id="madcoders.sylius_rma_plugin.generator.order_return_form_pdf_file_generator" class="Madcoders\SyliusRmaPlugin\Generator\OrderReturnFormPdfFileGenerator">
            <argument type="service" id="twig" />
            <argument type="service" id="Madcoders\SyliusRmaPlugin\Services\Pdf\PdfGeneratorInterface" />
            <argument type="service" id="file_locator" />
            <argument>@MadcodersSyliusRmaPlugin/Return/Download/pdf.html.twig</argument>
            <argument>@MadcodersSyliusRmaPlugin/Resources/pdf/sylius-logo.png</argument>
            <argument type="service"  id="madcoders.sylius_rma_plugin.services.configuration.return_address_configurator" />
            <argument type="service" id= "sylius.repository.channel" />
        </service>

        <service id="madcoders.sylius_rma_plugin.generator.return_number_generator" class="Madcoders\SyliusRmaPlugin\Generator\ReturnNumberGenerator">
            <argument type="service" id="madcoders_rma.repository.order_return" />
        </service>

        <!-- Alias the interface to the default generator so integrators can replace or decorate it. -->
        <service id="Madcoders\SyliusRmaPlugin\Generator\ReturnNumberGeneratorInterface" alias="madcoders.sylius_rma_plugin.generator.return_number_generator" />

        <service id="madcoders.sylius_rma_plugin.services.pdf.gotenberg_pdf_generator" class="Madcoders\SyliusRmaPlugin\Services\Pdf\GotenbergPdfGenerator">
            <argument type="service" id="http_client" />
            <argument>%madcoders_rma.gotenberg_url%</argument>
        </service>

        <!-- Alias the interface to the default Gotenberg-backed generator so integrators can replace or decorate it. -->
        <service id="Madcoders\SyliusRmaPlugin\Services\Pdf\PdfGeneratorInterface" alias="madcoders.sylius_rma_plugin.services.pdf.gotenberg_pdf_generator" />

     </services>
</container>
