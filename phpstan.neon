includes:
    - phpstan-baseline.neon

parameters:
    level: max
    reportUnmatchedIgnoredErrors: false
    paths:
        - src

    doctrine:
        objectManagerLoader: tests/object-manager.php

    excludePaths:
        # Makes PHPStan crash
        - 'src/DependencyInjection/Configuration.php'

        # Public extension-point trait for the application's Product model. It is consumed by the
        # host app (and the test application), which live outside the analysed `src` scope, so
        # PHPStan reports a false-positive `trait.unused` here.
        - 'src/Entity/NonReturnableProductTrait.php'

        # Test dependencies
        - 'tests/Application/**'

    ignoreErrors:
        - '/Parameter #1 \$configuration of method Symfony\\Component\\DependencyInjection\\Extension\\Extension::processConfiguration\(\) expects Symfony\\Component\\Config\\Definition\\ConfigurationInterface, Symfony\\Component\\Config\\Definition\\ConfigurationInterface\|null given\./'
        # Untyped iterables are accepted by the Sylius PHPStan standard.
        - identifier: missingType.iterableValue

        # Sylius 1.13 made the Order/Channel/ProductVariant repository interfaces generic and
        # PHPStan then demands the type parameters. On 1.12 those interfaces are not generic yet,
        # so the very same annotations are reported as `generics.notGeneric`. The plugin supports
        # both lines, so the annotations stay and the 1.12-only complaint is ignored here
        # (`reportUnmatchedIgnoredErrors: false` keeps this entry quiet on 1.13).
        -
            identifier: generics.notGeneric
            message: '#(class|interface) Sylius\\[A-Za-z\\]+\\(Order|Channel|ProductVariant)Repository(Interface)? is not generic\.$#'
