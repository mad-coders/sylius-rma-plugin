{
    "name": "madcoders/sylius-rma-plugin",
    "type": "sylius-plugin",
    "description": "RMA Plugin",
    "license": "EUPL-1.2",
    "authors": [
        {
            "name": "Piotr Lewandowski",
            "email": "p.lewandowski@madcoders.pl",
            "homepage": "https://www.madcoders.co",
            "role": "Architect & Developer"
        },
        {
            "name": "Leonid Moshko",
            "email": "l.moshko@madcoders.pl",
            "homepage": "https://www.madcoders.co",
            "role": "Architect & Developer"
        }
    ],
    "keywords": [
        "sylius",
        "sylius-plugin"
    ],
    "require": {
        "php": "^8.2",
        "knplabs/knp-snappy-bundle": "^1.10",
        "sylius/sylius": "^2.2"
    },
    "require-dev": {
        "api-platform/doctrine-orm": "~4.2.1",
        "api-platform/state": "~4.2.1",
        "api-platform/symfony": "~4.2.1",
        "behat/behat": "^3.16",
        "dmore/behat-chrome-extension": "^1.4",
        "dmore/chrome-mink-driver": "^2.9",
        "friends-of-behat/mink": "^1.11",
        "friends-of-behat/mink-browserkit-driver": "^1.6",
        "friends-of-behat/mink-debug-extension": "^2.1",
        "friends-of-behat/mink-extension": "^2.7",
        "friends-of-behat/page-object-extension": "^0.3",
        "friends-of-behat/suite-settings-extension": "^1.1",
        "friends-of-behat/symfony-extension": "^2.6",
        "friends-of-behat/variadic-extension": "^1.6",
        "phpspec/prophecy-phpunit": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^10.5",
        "rector/rector": "^2.0",
        "sylius-labs/coding-standard": "^4.4",
        "sylius/sylius-rector": "^3.7",
        "symfony/browser-kit": "^6.4 || ^7.1",
        "symfony/debug-bundle": "^6.4 || ^7.1",
        "symfony/dom-crawler": "^6.4 || ^7.1",
        "symfony/dotenv": "^6.4 || ^7.1",
        "symfony/error-handler": "^6.4 || ^7.1",
        "symfony/intl": "^6.4 || ^7.1",
        "symfony/mime": "^6.4 || ^7.1",
        "symfony/twig-bridge": "^6.4 || ^7.1",
        "symfony/type-info": "^6.4 || ^7.1",
        "symfony/var-dumper": "^6.4 || ^7.1",
        "symfony/var-exporter": "^6.4 || ^7.1",
        "symfony/web-link": "^6.4 || ^7.1",
        "symfony/web-profiler-bundle": "^6.4 || ^7.1",
        "symfony/webpack-encore-bundle": "^2.2"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "rector/extension-installer": true,
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-2.0": "2.0-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Madcoders\\SyliusRmaPlugin\\": "src/",
            "Tests\\Madcoders\\SyliusRmaPlugin\\": "tests/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/Application/Kernel.php"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-update-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-create-project-cmd": [
            "php bin/create_node_symlink.php"
        ]
    }
}
