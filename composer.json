{
    "name": "madcoders/sylius-rma-plugin",
    "type": "sylius-plugin",
    "description": "RMA Plugin",
    "license": "EUPL-1.2",
    "authors": [
        {
            "name": "Piotr Lewandowski",
            "email": "p.lewandowski@madcoders.pl",
            "homepage": "https://www.madcoders.co",
            "role": "Architect & Developer"
        },
        {
            "name": "Leonid Moshko",
            "email": "l.moshko@madcoders.pl",
            "homepage": "https://www.madcoders.co",
            "role": "Architect & Developer"
        }
    ],
    "keywords": [
        "sylius",
        "sylius-plugin"
    ],
    "require": {
        "php": "^8.2",
        "sylius/sylius": ">=1.12,<1.14",
        "symfony/http-client": "^6.4 || ^7.0",
        "symfony/mime": "^6.4 || ^7.0"
    },
    "require-dev": {
        "behat/behat": "^3.7",
        "dmore/behat-chrome-extension": "^1.3",
        "dmore/chrome-mink-driver": "^2.7",
        "friends-of-behat/mink": "^1.8",
        "friends-of-behat/mink-browserkit-driver": "^1.4",
        "friends-of-behat/mink-debug-extension": "^2.0",
        "friends-of-behat/mink-extension": "^2.4",
        "friends-of-behat/page-object-extension": "^0.3",
        "friends-of-behat/suite-settings-extension": "^1.0",
        "friends-of-behat/symfony-extension": "^2.1",
        "friends-of-behat/variadic-extension": "^1.3",
        "phpspec/prophecy-phpunit": "^2.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^9.5",
        "polishsymfonycommunity/symfony-mocker-container": "^1.0",
        "rector/rector": "^2.0",
        "sylius-labs/coding-standard": "^4.0",
        "sylius/sylius-rector": "^3.7",
        "symfony/browser-kit": "^6.4",
        "symfony/debug-bundle": "^6.4",
        "symfony/dotenv": "^6.4",
        "symfony/intl": "^6.4",
        "symfony/web-profiler-bundle": "^6.4",
        "symfony/webpack-encore-bundle": "^1.15"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "rector/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true,
        "audit": {
            "block-insecure": false,
            "ignore": [
                "PKSA-3ncz-km6v-5vjr",
                "PKSA-gs8r-6kz6-pp56",
                "PKSA-gnn4-pxdg-q76m",
                "PKSA-4g5g-4rkv-myqs"
            ]
        },
        "policy": {
            "advisories": {
                "ignore": ["api-platform/core", "enshrined/svg-sanitize", "guzzlehttp/guzzle", "guzzlehttp/psr7"]
            }
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.12-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Madcoders\\SyliusRmaPlugin\\": "src/",
            "Tests\\Madcoders\\SyliusRmaPlugin\\": "tests/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/Application/Kernel.php"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-update-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-create-project-cmd": [
            "php bin/create_node_symlink.php"
        ]
    }
}
